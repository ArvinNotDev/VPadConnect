QMainWindow {
    background-color: #f2f2f5;
}

QWidget {
    font-family: "Segoe UI";
}

QLabel {
    color: #222222;
    font-weight: 500;
}

QPushButton {
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 7px;
    border: 1px solid #cfd3e5;
    background-color: #f7f8fc;
    color: #30354f;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #edf0ff;
    border-color: #7c75ff;
}

QPushButton:pressed {
    background-color: #e0e4fb;
}

QPushButton:disabled {
    background-color: #eeeeF3;
    color: #a2a5b2;
    border-color: #ddddE6;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #252943;
    border: 1px solid #cfd3e5;
    border-radius: 7px;
    padding: 6px 8px;
    selection-background-color: #635bff;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #635bff;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 22px;
    background-color: #e9ebf6;
    border-left: 1px solid #cfd3e5;
}

QAbstractSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #d9ddf4;
}

QCheckBox {
    spacing: 8px;
    padding: 3px 0;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #dfe2f0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #635bff;
}

#sidebar_menu {
    border: none;
    background: transparent;
    padding: 4px 0;
}

#sidebar_menu::item {
    padding: 12px 14px;
    margin: 2px 0;
    border-radius: 8px;
    background: transparent;
}

#sidebar_menu::item:selected {
    background-color: #4d46e6;
}

#sidebar_menu::item:hover {
    background-color: #e7eaff;
}

QListWidget {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 8px;
    color: #222222;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 12px 10px;
    margin: 2px 0;
    color: #222222;
    border-radius: 6px;
    background-color: #ffffff;
}

QListWidget::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:hover {
    background-color: #e8e8f0;
    color: #222222;
}

QScrollBar:vertical {
    border: none;
    background: #f0f0f5;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7eeaf3, stop:1 #4d46e6
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}
QComboBox {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    color: #222222;
}

QComboBox:hover {
    border-color: #38cde1;
}

QComboBox:focus {
    border-color: #635bff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #ccccdd;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    margin-right: 8px;
}

/* ===== THE IMPORTANT PART ===== */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 6px;
    padding: 6px;
    color: #222222;
    selection-background-color: #635bff;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #e8e8f0;
    color: #222222;
}

QComboBox QAbstractItemView::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
    color: #ffffff;
}

/* ===================== Profiles Page ===================== */
QGroupBox {
    border: 1px solid #ccccdd;
    border-radius: 6px;
    margin-top: 8px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
    color: #444455;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #666677;
}

QPushButton#profiles_activate_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#profiles_activate_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7eeaf3, stop:1 #4d46e6
    );
}

QPushButton#profiles_new_btn {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_new_btn:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7eeaf3, stop:1 #4d46e6
    );
}

QPushButton#profiles_import_btn, QPushButton#profiles_export_btn {
    background-color: #f5f6fb;
    color: #555b78;
    border: 1px solid #cfd3e5;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#profiles_import_btn:hover, QPushButton#profiles_export_btn:hover {
    background-color: #e9ebf7;
    color: #252943;
    border-color: #635bff;
}

QListWidget#profiles_list {
    background-color: #ffffff;
    border: 1px solid #d7d9e5;
    border-radius: 12px;
    padding: 8px;
}

QListWidget#profiles_list::item {
    padding: 12px 10px;
    margin: 3px 0;
    border-radius: 8px;
    background-color: transparent;
}

QListWidget#profiles_list::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7c75ff, stop:1 #4d46e6
    );
}

QPushButton#profiles_delete_btn {
    background-color: #fff0f0;
    color: #cc3333;
    border: 1px solid #ddaaaa;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#profiles_delete_btn:hover {
    background-color: #ffe0e0;
    border-color: #cc3333;
}

QSplitter::handle {
    background-color: #ccccdd;
    width: 2px;
    margin: 8px 4px;
    border-radius: 1px;
}

QPushButton#settings_save_profile {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ecdc4, stop:1 #2eaa9b
    );
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#settings_save_profile:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6ee0d8, stop:1 #4ecdc4
    );
}

#settings_profile_menu {
    background-color: #ffffff;
    border: 2px solid #ccccdd;
    border-radius: 8px;
    padding: 6px;
    color: #222222;
}

#settings_profile_menu QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #222222;
}

#settings_profile_menu QMenu::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #38cde1, stop:1 #635bff
    );
    color: #ffffff;
}

#settings_profile_menu QMenu::separator {
    height: 1px;
    background: #ccccdd;
    margin: 4px 8px;
}

QFrame#about_hero {
    background-color: #eef0ff;
    border: 1px solid #c9cef2;
    border-radius: 18px;
}

QLabel#about_badge {
    color: #5967c8;
    font-size: 11px;
    font-weight: 800;
}

QLabel#about_title {
    color: #20243a;
    font-size: 25px;
    font-weight: 800;
}

QLabel#about_version {
    color: #237665;
    background: #d9f2eb;
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: 700;
}

QLabel#about_tagline, QLabel#about_body {
    color: #565b73;
    font-size: 13px;
}

QFrame#about_info_card {
    background-color: #ffffff;
    border: 1px solid #d7d9e5;
    border-radius: 14px;
}

QLabel#about_section_title {
    color: #252943;
    font-size: 16px;
    font-weight: 700;
}

QLabel#about_meta, QLabel#about_tip {
    color: #747991;
    font-size: 12px;
}

QPushButton#about_primary_btn, QPushButton#about_secondary_btn {
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton#about_primary_btn {
    background-color: #5d6fd9;
    color: #ffffff;
    border: 1px solid #7181e2;
}

QPushButton#about_primary_btn:hover { background-color: #7384eb; }

QPushButton#about_secondary_btn {
    background-color: transparent;
    color: #5363bf;
    border: 1px solid #a8b0dd;
}

QPushButton#about_secondary_btn:hover { background-color: #eff1ff; }

/* Sidebar avatar */
#sidebar_avatar_container {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #dddddd;
}

#sidebar_profile_name {
    color: #222233;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#github_button {
    background-color: #f0f0f5;
    color: #555566;
    border: 1px solid #ccccdd;
    border-radius: 6px;
    padding: 8px 6px;
    font-size: 11px;
}

QPushButton#github_button:hover {
    background-color: #e4e4f0;
    color: #222233;
    border-color: #635bff;
}

/* Profile image buttons */
QPushButton#profiles_set_image_btn {
    background-color: #f0f0f5;
    color: #555566;
    border: 1px solid #ccccdd;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QPushButton#profiles_set_image_btn:hover {
    background-color: #e0e0ea;
    color: #222233;
    border-color: #635bff;
}

QPushButton#profiles_remove_image_btn {
    background-color: #fff0f0;
    color: #cc3333;
    border: 1px solid #ddaaaa;
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#profiles_remove_image_btn:hover {
    background-color: #ffe0e0;
    border-color: #cc3333;
}

QPushButton#profiles_remove_image_btn:disabled {
    background-color: #f5f5f8;
    color: #aaaaaa;
    border-color: #dddddd;
}

QPushButton#profiles_save_desc_btn {
    background-color: #f0f0f5;
    color: #555566;
    border: 1px solid #ccccdd;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
}

QPushButton#profiles_save_desc_btn:hover {
    background-color: #e0e0ea;
    color: #222233;
    border-color: #635bff;
}

QPushButton#profiles_save_desc_btn:disabled {
    background-color: #f5f5f8;
    color: #aaaaaa;
    border-color: #dddddd;
}

QTextEdit {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #ccccdd;
    border-radius: 4px;
    padding: 6px;
}

QFrame#lightbar_preview {
    border: 1px solid #9da3b4;
    border-radius: 5px;
}


/* ===================== VPadConnect modern shell ===================== */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #edf3ff, stop:0.56 #f5f5ff, stop:1 #f8efff);
}

#app_root {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #edf3ff, stop:0.58 #f5f6ff, stop:1 #f9f0ff);
}

#app_header {
    background: transparent;
}

#brand_mark {
    border: 1px solid #8295ff;
    border-radius: 14px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 900;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #435ce7, stop:0.52 #7657e5, stop:1 #0ba9bf);
}

#brand_title {
    color: #18223b;
    font-size: 20px;
    font-weight: 800;
}

#brand_subtitle {
    color: #74809c;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 2px;
}

#profile_chip {
    background: rgba(255,255,255,0.74);
    border: 1px solid #dce3f2;
    border-radius: 15px;
}

#sidebar_profile_name {
    color: #202b45;
    font-size: 12px;
    font-weight: 700;
}

#sidebar_profile_label {
    color: #7b87a1;
    font-size: 10px;
}

QListWidget#top_navigation {
    background: rgba(255,255,255,0.64);
    border: 1px solid #dce3f2;
    border-radius: 15px;
    padding: 5px;
    outline: none;
}

QListWidget#top_navigation::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #66728d;
    padding: 11px 15px;
    margin: 1px 2px;
    font-size: 10pt;
    font-weight: 600;
}

QListWidget#top_navigation::item:hover {
    background: #e9edff;
    border-color: #d0d8f5;
    color: #253357;
}

QListWidget#top_navigation::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5366e8, stop:0.55 #6c5cde, stop:1 #865cdb);
    border: 1px solid #8a8cff;
    color: #ffffff;
    font-weight: 700;
}

QStackedWidget#content_stack {
    background: rgba(255,255,255,0.38);
    border: 1px solid #dce3f2;
    border-radius: 18px;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d6deef;
    border-radius: 9px;
    color: #303b57;
    padding: 7px 13px;
    font-weight: 600;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #edf0ff, stop:1 #f1eaff);
    border-color: #8592ed;
    color: #28365b;
}

QPushButton:pressed {
    background: #e4e8fb;
}

QPushButton#github_button {
    background: rgba(255,255,255,0.55);
    border: 1px solid #d6deef;
    color: #5d6b89;
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton#github_button:hover {
    background: #eef0ff;
    border-color: #8b96ef;
    color: #29365b;
}

QPushButton#quit_button {
    background: rgba(255,255,255,0.6);
    border: 1px solid #d6deef;
    color: #6c7893;
    border-radius: 11px;
    font-size: 17px;
    padding: 5px;
}

QPushButton#quit_button:hover {
    background: #fff0f2;
    border-color: #e59bac;
    color: #b83d5d;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: rgba(255,255,255,0.94);
    color: #26324c;
    border: 1px solid #d3dced;
    border-radius: 9px;
    selection-background-color: #6673dc;
    padding: 7px 10px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #7b87e6;
    background: #ffffff;
}

QGroupBox {
    background: rgba(255,255,255,0.45);
    border: 1px solid #dce3f2;
    border-radius: 12px;
    margin-top: 13px;
    padding: 14px 10px 10px 10px;
    color: #485572;
}

QGroupBox::title {
    color: #596783;
    padding: 0 7px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #b5c0de;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7988e6;
}


/* Focused navigation refinement: lightweight tabs, no container frame. */
#app_root {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #edf3ff, stop:0.68 #f4f5fc, stop:1 #f7f0fc);
}

#brand_mark {
    border: none;
    border-radius: 11px;
    font-size: 14px;
}

#brand_title {
    font-size: 19px;
    font-weight: 750;
}

#profile_chip {
    background: transparent;
    border: none;
    border-radius: 0;
}

QTabBar#top_navigation {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QTabBar#top_navigation::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #74809a;
    padding: 10px 13px 9px 13px;
    margin: 0 3px 0 0;
    min-width: 58px;
    font-size: 10pt;
    font-weight: 600;
}

QTabBar#top_navigation::tab:hover {
    background: rgba(91,105,209,0.06);
    border-bottom-color: #d0d6e8;
    color: #293654;
}

QTabBar#top_navigation::tab:selected {
    background: transparent;
    border: none;
    border-bottom: 2px solid #6a72e6;
    color: #28345a;
    font-weight: 700;
}

QTabBar#top_navigation QToolButton {
    background: transparent;
    border: none;
    color: #75819b;
    min-width: 22px;
    padding: 0;
}

QTabBar#top_navigation QToolButton:hover {
    background: rgba(91,105,209,0.08);
    border-radius: 6px;
}

QStackedWidget#content_stack {
    background: transparent;
    border: none;
    border-radius: 0;
}


/* Frameless Apple-inspired title bar */
QPushButton#window_minimize, QPushButton#window_maximize, QPushButton#window_close {
    border: none; border-radius: 7px; padding: 0; min-width: 13px; max-width: 13px;
    min-height: 13px; max-height: 13px;
}
QPushButton#window_minimize { background: #f6c65b; }
QPushButton#window_maximize { background: #35c76b; }
QPushButton#window_close { background: #ff5f57; }
QPushButton#window_minimize:hover { background: #ffda79; }
QPushButton#window_maximize:hover { background: #61dc89; }
QPushButton#window_close:hover { background: #ff837d; }
QPushButton#profile_chip { text-align: left; padding: 3px 8px; }
QPushButton#profile_chip:hover { background: #e8ebf7; border-color: #aeb8d5; }
QPushButton#settings_gear { background: #f8f9fd; border: 1px solid #d2d8e7; border-radius: 12px;
    padding: 0; color: #333b57; font-size: 21px; font-weight: 500; }
QPushButton#settings_gear:hover { background: #e9edfb; border-color: #979cf0; }
QTabBar#settings_navigation { background: transparent; border: none; padding: 0; margin: 0 0 8px 0; }
QTabBar#settings_navigation::tab { background: transparent; color: #707893; border: none;
    border-bottom: 2px solid transparent; padding: 8px 14px; margin-right: 5px; font-weight: 650; }
QTabBar#settings_navigation::tab:hover { color: #252943; background: rgba(99,91,255,0.06); }
QTabBar#settings_navigation::tab:selected { color: #30354f; border-bottom-color: #635bff; }


/* Final title-bar refinements */
QPushButton#window_close, QPushButton#window_minimize, QPushButton#window_maximize {
    min-width: 14px; max-width: 14px; min-height: 14px; max-height: 14px;
    border: none; border-radius: 7px; padding: 0; margin: 0;
}
QPushButton#profile_chip {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #ffffff, stop:1 #f0f3fb);
    border: 1px solid #cbd4e5; border-radius: 13px;
    padding: 3px 11px; text-align: left;
}
QPushButton#profile_chip:hover { background: #e8edfa; border-color: #9ba9ca; }
QPushButton#settings_gear {
    background: #f8f9fd; border: 1px solid #d2d8e7; border-radius: 12px;
    padding: 0; color: #333b57; font-size: 21px; font-weight: 500;
}
QPushButton#settings_gear:hover { background: #e9edfb; border-color: #979cf0; }
#sidebar_profile_name { color: #252b43; font-size: 12px; font-weight: 750; }
#sidebar_profile_label { color: #5f6b86; font-size: 10px; }


/* Richer, coordinated desktop gradients */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eaf2ff, stop:0.3 #eff2ff, stop:0.62 #f2edff,
        stop:0.84 #e8f4fb, stop:1 #eef5ff);
}
#app_root {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #edf4ff, stop:0.26 #f0f2ff, stop:0.52 #f8f1ff,
        stop:0.78 #eaf5ff, stop:1 #eff9fb);
}
QStackedWidget#content_stack {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.96), stop:0.58 rgba(248,249,255,0.96),
        stop:1 rgba(243,248,255,0.96));
    border: 1px solid #d4ddef;
    border-radius: 18px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:0.55 #f1f4ff, stop:1 #f4efff);
    border: 1px solid #d0d8eb;
    color: #28334f;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #e2ecff, stop:0.5 #eae5ff, stop:1 #def5fb);
    border-color: #9ba9ed;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #d8e4fa, stop:1 #e5dcf9);
}
QPushButton#profile_chip {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:0.55 #f3f5ff, stop:1 #f4efff);
    border: 1px solid #cbd5e9;
    border-radius: 14px;
    padding: 4px 12px;
}
QPushButton#profile_chip:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #e1ecff, stop:1 #ede4ff);
    border-color: #98a5de;
}
QPushButton#settings_gear {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:1 #ecefff);
    border: 1px solid #d0d8eb;
    border-radius: 12px;
}
QPushButton#settings_gear:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #dbe8ff, stop:1 #e6dcff);
    border-color: #9aa3e8;
}
QListWidget#top_navigation::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #647ef2, stop:0.5 #8871e9, stop:1 #2ba5bb);
    border: 1px solid #a2a9f4;
    color: #ffffff;
}


/* The active underline is drawn by AnimatedTabBar and moves between tabs. */
QTabBar#top_navigation::tab:selected,
QTabBar#settings_navigation::tab:selected {
    border-bottom-color: transparent;
}

/* Quiet, narrow scrollbars shared by every scrollable widget. */
QScrollBar:vertical {
    width: 7px;
    margin: 2px 1px 2px 1px;
    border: none;
    border-radius: 3px;
    background: rgba(39, 56, 86, 0.035);
}
QScrollBar:horizontal {
    height: 7px;
    margin: 1px 2px 1px 2px;
    border: none;
    border-radius: 3px;
    background: rgba(39, 56, 86, 0.035);
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    min-height: 24px;
    min-width: 24px;
    border: none;
    border-radius: 3px;
    background: #a8b3ca;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7587b2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Profile management workspace */
QFrame#profileListPanel, QFrame#profileHero, QFrame#profileSectionCard {
    background: rgba(255, 255, 255, 82%);
    border: 1px solid #dbe3f1;
    border-radius: 14px;
}
QFrame#profileHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f5f8ff, stop:1 #f6f2ff);
}
QScrollArea#profileDetailScroll, QWidget#profileDetailContent {
    background: transparent;
    border: none;
}
QLabel#profilesPageTitle {
    color: #202b45;
    font-size: 20px;
    font-weight: 750;
}
QLabel#profilesPageSubtitle {
    color: #707e99;
    font-size: 11px;
}
QLabel#profileName {
    color: #202b45;
    font-size: 25px;
    font-weight: 800;
}
QLabel#profileStatus {
    color: #71809a;
    font-size: 11px;
    font-weight: 650;
    padding: 4px 8px;
    border-radius: 8px;
    background: #edf1f8;
}
QLabel#profileStatus[active="true"] {
    color: #18775f;
    background: #def3eb;
}
QLabel#profileSectionTitle {
    color: #26344f;
    font-size: 14px;
    font-weight: 750;
}
QLabel#profileMetaValue {
    color: #61708a;
    font-size: 11px;
}
QTextEdit#profileDescription, QTextEdit#profileSettingsSummary {
    background: rgba(248, 250, 255, 92%);
    color: #33415c;
    border: 1px solid #dce4f1;
    border-radius: 9px;
    padding: 9px;
}
QTextEdit#profileSettingsSummary {
    font-size: 11px;
}
QPushButton#profiles_manage_btn {
    background: #f4f6fb;
    color: #596782;
    border: 1px solid #d8e0ed;
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 11px;
}
QPushButton#profiles_manage_btn:hover {
    background: #e9eef9;
    border-color: #a8b5d0;
}
QLabel#profile_dropdown_chevron {
    color: #71809a;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#profile_chip::menu-indicator {
    image: none;
    width: 0;
}
QMenu#profile_selector_menu {
    background: #ffffff;
    color: #273550;
    border: 1px solid #d4ddec;
    border-radius: 10px;
    padding: 5px;
}
QMenu#profile_selector_menu::item {
    padding: 8px 30px 8px 12px;
    border-radius: 6px;
}
QMenu#profile_selector_menu::item:selected {
    background: #edf1fa;
    color: #243454;
}
QMenu#profile_selector_menu::item:checked {
    background: #e2e9fb;
    color: #27376b;
}


/* Framed desktop shell with a restrained outline beneath the native title bar. */
#app_root {
    border: 1px solid #ccd8e7;
    border-radius: 14px;
}


/* Standard Windows-like caption actions in the frameless desktop header. */
QPushButton#window_minimize, QPushButton#window_maximize, QPushButton#window_close {
    min-width: 42px;
    max-width: 42px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: transparent;
}
QPushButton#window_minimize:hover, QPushButton#window_maximize:hover {
    background: rgba(70, 90, 120, 12%);
}
QPushButton#window_close:hover {
    background: #d94d5b;
}
QPushButton#window_minimize:pressed, QPushButton#window_maximize:pressed {
    background: rgba(70, 90, 120, 18%);
}
QPushButton#window_close:pressed {
    background: #b83c49;
}
